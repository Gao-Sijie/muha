{
  "name": "@muha-sdk/pi-adapter",
  "version": "0.1.13",
  "description": "Official Pi SDK adapter for Muha SDK.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.20.0"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -b --pretty false && npm run build:sdk",
    "build:sdk": "node scripts/build-sdk.mjs",
    "prepack": "node scripts/build-sdk.mjs --check",
    "test": "npm run build:sdk && node --test --test-concurrency=2 test/*.test.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@muha-sdk/core": "0.1.13"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Gao-Sijie/muha.git",
    "directory": "packages/pi-adapter"
  },
  "bugs": {
    "url": "https://github.com/Gao-Sijie/muha/issues"
  },
  "homepage": "https://github.com/Gao-Sijie/muha/tree/main/packages/pi-adapter#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
