server.listen(0, "127.0.0.1", () => {
  process.stdout.write(process.env.MUHA_V2_READY === "malformed"
    ? "not-json\n"
    : JSON.stringify({ url: "http://127.0.0.1:" + server.address().port }) + "\n");
});
process.stdin.resume();
process.stdin.on("end", () => server.close());

function json(response, status, value) {
  response.writeHead(status, { "content-type": "application/json" }).end(JSON.stringify(value));
}

async function readBody(request) {
  let body = "";
  for await (const chunk of request) body += chunk;
  return body;
}

function emit(session, type, data, durable = true) {
  const event = {
    id: "evt_" + (session.seq + 1),
    created: Date.now(),
    type,
    location: session.location,
    ...(durable ? { durable: { aggregateID: session.id, seq: ++session.seq, version: 1 } } : {}),
    data: { sessionID: session.id, ...data },
  };
  for (const stream of streams) stream.write("data: " + JSON.stringify(event) + "\n\n");
}

async function runTextTurn(session, inbox) {
  emit(session, "session.inbox.enqueued", { inboxID: inbox.id, item: inbox });
  emit(session, "session.execution.started", {});
  emit(session, "session.inbox.delivered", { inboxID: inbox.id });
  if (process.env.MUHA_V2_STREAM === "disconnect") {
    for (const stream of streams) stream.end();
    return;
  }
  if (process.env.MUHA_V2_STREAM === "private-gap") session.seq += 1;
  const outputs = process.env.MUHA_V2_USAGE === "multi"
    ? ["Intermediate", "OpenCode v2: " + inbox.payload.text]
    : [process.env.MUHA_V2_FINAL === "blank" ? "   " : "OpenCode v2: " + inbox.payload.text];
  for (const [index, output] of outputs.entries()) {
    const assistantMessageID = "msg_assistant_" + nextMessage++;
    const message = {
      id: assistantMessageID,
      time: { created: Date.now(), completed: Date.now() },
      type: "assistant",
      agent: "build",
      model: { providerID: "opencode-go", id: "deepseek-v4.1-flash" },
      content: [{ type: "text", text: output }],
      tokens: { input: 4 + index, output: 6 + index, reasoning: index,
        cache: { read: index, write: 0 } },
    };
    if (process.env.MUHA_V2_STREAM !== "gap") {
      emit(session, "session.step.started", {
        assistantMessageID,
        agent: "build",
        model: message.model,
        started: Date.now(),
      });
    }
    if (process.env.MUHA_V2_RETRY) {
      const retry = process.env.MUHA_V2_RETRY;
      if (retry === "after-text" || retry === "after-reasoning") {
        emit(session, retry === "after-text" ? "session.text.delta" : "session.reasoning.delta",
          { assistantMessageID, ordinal: 0, delta: "Already visible." }, false);
      }
      if (retry === "after-tool") emit(session, "session.tool.input.started",
        { assistantMessageID, id: "retry_tool", name: "shell" });
      if (retry !== "unmarked") emit(session, "session.retry.scheduled", {
        assistantMessageID, attempt: retry === "invalid-attempt" ? 1 : 2,
        at: Date.now(), error: { message: "controlled provider retry" } });
      if (retry !== "missing-restart") emit(session, "session.step.started", { assistantMessageID,
        ...(retry === "different-message" ? { assistantMessageID: "msg_different" } : {}),
        agent: "build", model: message.model, started: Date.now() });
      if (retry === "scheduled-twice") {
        emit(session, "session.retry.scheduled", { assistantMessageID, attempt: 3,
          at: Date.now(), error: { message: "second controlled retry" } });
        emit(session, "session.step.started", { assistantMessageID,
          agent: "build", model: message.model, started: Date.now() });
      }
    }
    if (process.env.MUHA_V2_REASONING === "on") {
      emit(session, "session.reasoning.delta", { assistantMessageID, ordinal: 0,
        delta: "Thinking." }, false);
    }
    emit(session, "session.text.started", { assistantMessageID, ordinal: 0 });
    emit(session, "session.text.delta", { assistantMessageID, ordinal: 0, delta: output }, false);
    emit(session, "session.text.ended", { assistantMessageID, ordinal: 0, text: output });
    if (process.env.MUHA_V2_CHILD === "active" && index === 0) runChildTurn(session);
    if (process.env.MUHA_V2_TOOL) {
      const count = process.env.MUHA_V2_TOOL === "multi" ? 2 : 1;
      for (let toolIndex = 0; toolIndex < count; toolIndex++) {
        const id = "call_" + toolIndex;
        const name = toolIndex === 0 ? "read" : "shell";
        emit(session, "session.tool.input.started", { assistantMessageID, id, name });
        emit(session, "session.tool.input.ended", { assistantMessageID, id,
          text: JSON.stringify({ path: "file-" + toolIndex }) });
        emit(session, "session.tool.called", { assistantMessageID, id,
          input: { path: "file-" + toolIndex }, executed: true });
        emit(session, "session.tool.progress", { assistantMessageID, id,
          metadata: { phase: "reading" } }, false);
        if (process.env.MUHA_V2_TOOL === "failure") {
          emit(session, "session.tool.failed", { assistantMessageID, id,
            error: { name: "ToolError", message: "controlled failure" }, executed: true });
        } else {
          emit(session, "session.tool.success", { assistantMessageID, id,
            content: [{ type: "text", text: "done-" + toolIndex }], executed: true });
        }
        if (process.env.MUHA_V2_TOOL === "duplicate") {
          emit(session, "session.tool.success", { assistantMessageID, id,
            content: [{ type: "text", text: "done-" + toolIndex }], executed: true });
        }
      }
    }
    if (process.env.MUHA_V2_PERMISSION === "ask") {
      const requestID = "per_" + nextMessage++;
      const waiting = new Promise((resolve) => pendingPermissions.set(requestID, { session, resolve }));
      emit(session, "permission.asked", { id: requestID, action: "read", resources: ["file-0"],
        ...(process.env.MUHA_V2_TOOL ? { source: { type: "tool", messageID: assistantMessageID, id: "call_0" } } : {}) }, false);
      await waiting;
      if (session.interrupted) return;
    }
    if (process.env.MUHA_V2_FORM) {
      const formID = "form_" + nextMessage++;
      const fields = process.env.MUHA_V2_FORM === "empty"
        ? [{ key: "", type: "string", custom: true, default: "v-a",
          options: [{ value: "v-a", label: "" }] },
          { key: "visit", type: "external", url: "" }]
        : process.env.MUHA_V2_FORM === "text_constraints"
          ? [{ key: "email", type: "string", required: true, format: "email" },
            { key: "link", type: "string", required: true, format: "uri" },
            { key: "timestamp", type: "string", required: true, format: "date-time" },
            { key: "code", type: "string", required: true, pattern: "^A[0-9]{2}$",
              minLength: 3, maxLength: 3, placeholder: "A00" },
            { key: "flag", type: "boolean", default: false },
            { key: "after", type: "string", when: [{ key: "flag", op: "neq", value: true }] }]
        : process.env.MUHA_V2_FORM === "native_reply_hidden"
          ? [{ key: "secret", type: "string", hidden: true, required: true,
            default: "token-private" },
            { key: "visible", type: "string", required: true,
              when: [{ key: "secret", op: "eq", value: "token-private" }] }]
        : process.env.MUHA_V2_FORM === "full"
        ? [{ key: "choice", type: "string", title: "Choose", required: true, default: "v-b",
          options: [{ value: "v-a", label: "Same" }, { value: "v-b", label: "Same" }] },
          { key: "count", type: "integer", title: "Count", required: true, default: 3,
            minimum: 1, maximum: 9, when: [{ key: "choice", op: "eq", value: "v-b" }] },
          { key: "toggle", type: "boolean", title: "Enable tags", default: false },
          { key: "secret", type: "string", title: "Secret", hidden: true, required: true,
            default: "token-private" },
          { key: "tags", type: "multiselect", title: "Tags", required: true,
            options: [{ value: "tag-x", label: "X" }, { value: "tag-y", label: "Y" }],
            custom: true, minItems: 2, maxItems: 4, when: [{ key: "toggle", op: "eq", value: true }] },
          { key: "date", type: "string", title: "Date", format: "date", minLength: 10,
            maxLength: 10, when: [{ key: "count", op: "eq", value: 3 },
              { key: "secret", op: "eq", value: "token-private" }] },
          { key: "amount", type: "number", title: "Amount", required: true,
            minimum: 1, maximum: 5, default: 1.5 },
          { key: "visit", type: "external", title: "Visit", url: "https://example.invalid/confirm" }]
        : process.env.MUHA_V2_FORM === "unsupported"
          ? [{ key: "count", type: "future", title: "Count", required: true }]
          : [{ key: "choice", type: "string", title: "Choose", required: true,
            ...(process.env.MUHA_V2_FORM === "constraint" ? { minLength: "invalid" } : {}),
            options: [{ value: "v-a", label: "Alpha" }, { value: "v-b", label: "Beta" }] },
            { key: process.env.MUHA_V2_FORM === "duplicate" ? "choice" : "tags",
              type: "multiselect", title: "Tags", required: false,
              options: [{ value: "tag-x", label: "X" }, { value: "tag-y", label: "Y" }], custom: true }];
      const waiting = new Promise((resolve) => pendingForms.set(formID, { session, resolve }));
      emit(session, "form.created", { form: { id: formID, sessionID: session.id,
        title: "Controlled form", fields,
        ...(process.env.MUHA_V2_FORM === "metadata" ? { metadata: { message: 42 } } : {}),
        ...(process.env.MUHA_V2_FORM === "full" ? { metadata: { message: "Complete the form",
          ...(process.env.MUHA_V2_TOOL ? { kind: "question",
            tool: { messageID: assistantMessageID, id: "call_0" } } : {}) } } : {}) } }, false);
      if (process.env.MUHA_V2_FORM === "native_reply" ||
          process.env.MUHA_V2_FORM === "native_reply_hidden") setTimeout(() => {
        const native = pendingForms.get(formID);
        if (!native) return;
        emit(session, "form.replied", { id: formID,
          answer: process.env.MUHA_V2_FORM === "native_reply_hidden"
            ? { secret: "token-private", visible: "yes" }
            : { choice: "v-a", tags: ["tag-y"] } }, false);
        pendingForms.delete(formID);
        native.resolve();
      }, 30);
      await waiting;
      if (session.interrupted) return;
    }
    session.messages.push(message);
    emit(session, "session.step.ended", {
      assistantMessageID,
      finish: index === outputs.length - 1 ? "stop" : "tool-calls",
      cost: 0,
      ...(process.env.MUHA_V2_USAGE === "missing" ? {} : { tokens: message.tokens }),
    });
  }
  emit(session, "session.execution.succeeded", {});
}

function runChildTurn(parent) {
  const id = "ses_v2_" + nextSession++;
  const child = { id, projectID: parent.projectID, location: parent.location,
    parentID: parent.id, time: { created: Date.now(), updated: Date.now() },
    seq: 0, messages: [] };
  sessions.set(id, child);
  emit(child, "session.created", { sessionID: id, parentID: parent.id,
    projectID: child.projectID, location: child.location, slug: id });
  emit(child, "session.execution.started", {});
  const assistantMessageID = "msg_assistant_" + nextMessage++;
  const message = { id: assistantMessageID,
    time: { created: Date.now(), completed: Date.now() }, type: "assistant",
    agent: "build", model: { providerID: "opencode-go", id: "deepseek-v4.1-flash" },
    content: [{ type: "text", text: "Child output" }],
    tokens: { input: 2, output: 3, reasoning: 0, cache: { read: 0, write: 0 } } };
  emit(child, "session.step.started", { assistantMessageID, agent: "build",
    model: message.model, started: Date.now() });
  emit(child, "session.text.started", { assistantMessageID, ordinal: 0 });
  emit(child, "session.text.delta", { assistantMessageID, ordinal: 0, delta: "Child output" }, false);
  emit(child, "session.text.ended", { assistantMessageID, ordinal: 0, text: "Child output" });
  emit(child, "session.tool.input.started", { assistantMessageID, id: "call_0", name: "child_read" });
  emit(child, "session.tool.input.ended", { assistantMessageID, id: "call_0", text: "{}" });
  emit(child, "session.tool.called", { assistantMessageID, id: "call_0", input: {}, executed: true });
  emit(child, "session.tool.success", { assistantMessageID, id: "call_0",
    content: [{ type: "text", text: "child done" }], executed: true });
  child.messages.push(message);
  emit(child, "session.step.ended", { assistantMessageID, finish: "stop", cost: 0, tokens: message.tokens });
  emit(child, "session.execution.succeeded", {});
}
