#!/usr/bin/env node
import { createServer } from "node:http";
import { readFile, rename, writeFile } from "node:fs/promises";
import { join } from "node:path";

if (JSON.stringify(process.argv.slice(2)) !== JSON.stringify(["serve", "--stdio", "--port", "0"])) {
  process.exit(64);
}
const password = process.env.OPENCODE_PASSWORD;
if (!password || process.env.OPENCODE_SERVER_PASSWORD) process.exit(65);
const authorization = "Basic " + Buffer.from("opencode:" + password).toString("base64");
const evidenceFile = process.env.MUHA_V2_EVIDENCE_FILE;
if (process.env.MUHA_V2_PID_FILE) await writeFile(process.env.MUHA_V2_PID_FILE, String(process.pid));
const evidence = { unauthenticated: 0, authenticated: 0, requests: [], created: 0, removed: 0,
  createdPermissions: [], prompts: [], permissions: [], forms: [], interrupts: [] };
let evidenceWrite = Promise.resolve();
let evidenceSequence = 0;
function persistEvidence() {
  if (!evidenceFile) return Promise.resolve();
  const snapshot = JSON.stringify(evidence);
  const temporaryFile = `${evidenceFile}.${process.pid}.${++evidenceSequence}.tmp`;
  evidenceWrite = evidenceWrite.then(async () => {
    await writeFile(temporaryFile, snapshot);
    await rename(temporaryFile, evidenceFile);
  });
  return evidenceWrite;
}
const sessions = new Map();
const streams = new Set();
const pendingPermissions = new Map();
const pendingForms = new Map();
const rejectedForms = new Set();
let nextSession = 1;
let nextMessage = 1;
let eventConnections = 0;
if (process.env.MUHA_V2_SESSIONS_FILE) {
  const seeded = JSON.parse(await readFile(process.env.MUHA_V2_SESSIONS_FILE, "utf8"));
  for (const value of seeded) {
    sessions.set(value.id, {
      id: value.id,
      projectID: "project-v2",
      location: { directory: value.directory },
      time: { created: value.createdAt ?? Date.now(), updated: value.updatedAt ?? Date.now() },
      ...(value.title === undefined ? {} : { title: value.title }),
      ...(value.model === undefined ? {} : { model: value.model }),
      seq: 0, messages: [],
    });
  }
}
const server = createServer(async (request, response) => {
  const url = new URL(request.url ?? "/", "http://127.0.0.1");
  evidence.requests.push(url.pathname);
  if (request.headers.authorization !== authorization) {
    evidence.unauthenticated += 1;
    response.writeHead(401).end();
  } else if (url.pathname === "/api/info") {
    evidence.authenticated += 1;
    json(response, 200, {
        version: process.env.MUHA_V2_VERSION ?? "2.0.11",
        pid: process.pid,
        urls: ["http://127.0.0.1:" + server.address().port],
        paths: { tmp: "/tmp/opencode" },
    });
  } else if (request.method === "GET" && url.pathname === "/api/event") {
    eventConnections += 1;
    response.writeHead(200, {
      "content-type": "text/event-stream",
      "cache-control": "no-cache",
      connection: "keep-alive",
    });
    response.write("data: " + JSON.stringify({ type: "server.connected", data: {} }) + "\n\n");
    streams.add(response);
    request.once("close", () => streams.delete(response));
    if (process.env.MUHA_V2_IDLE_DISCONNECT === "once" && eventConnections === 1) {
      setTimeout(() => response.end(), 10);
    }
  } else if (request.method === "GET" && url.pathname === "/api/plugin") {
    const directory = url.searchParams.get("location[directory]") ?? "";
    json(response, 200, {
      location: { directory },
      data: process.env.MUHA_V2_PLUGIN_STATE === "missing" ? [] : [{
        id: "muha.ordered-input",
        source: { type: "local", path: join(process.env.OPENCODE_CONFIG_DIR, "plugins", "muha-order.js") },
        features: { server: true },
        state: process.env.MUHA_V2_PLUGIN_STATE === "failed"
          ? { status: "failed", error: "controlled plugin failure" }
          : { status: "active" },
      }],
    });
  } else if (request.method === "POST" && url.pathname === "/api/session") {
    const body = JSON.parse(await readBody(request));
    const directory = body.location?.directory;
    if (typeof directory !== "string") {
      json(response, 400, { error: "missing location" });
    } else {
      const id = "ses_v2_" + nextSession++;
      const now = Date.now();
      const session = {
        id,
        projectID: "project-v2",
        location: { directory },
        time: { created: now, updated: now },
        cost: 0,
        tokens: { input: 0, output: 0, reasoning: 0, cache: { read: 0, write: 0 } },
        ...(body.model === undefined ? {} : { model: {
          ...body.model,
          ...(process.env.MUHA_V2_NATIVE_VARIANT === undefined
            ? {} : { variant: process.env.MUHA_V2_NATIVE_VARIANT }),
        } }),
        ...(body.permissions === undefined ? {} : { permissions: body.permissions }),
        seq: 0,
        interrupted: false,
        messages: [],
      };
      sessions.set(id, session);
      evidence.created += 1;
      evidence.createdPermissions.push(body.permissions);
      json(response, 200, process.env.MUHA_V2_CREATE_RESPONSE === "malformed"
        ? { data: { wrong: id } } : { data: session });
    }
  } else if (request.method === "GET" && url.pathname === "/api/session") {
    const directory = url.searchParams.get("directory");
    json(response, 200, {
      data: [...sessions.values()].filter((session) => session.location.directory === directory),
      cursor: {},
    });
  } else if (request.method === "GET" && url.pathname === "/api/model") {
    const directory = url.searchParams.get("location[directory]") ?? "";
    json(response, 200, {
      location: { directory },
      data: [{
        id: "deepseek-v4.1-flash",
        modelID: "deepseek-v4.1-flash",
        providerID: "opencode-go",
        capabilities: { tools: true,
          input: process.env.MUHA_V2_IMAGE_MODEL === "text-only" ? ["text"] : ["text", "image"],
          output: ["text"] },
        variants: [{ id: "high" }, { id: "low" }],
      }, {
        id: "other",
        modelID: "other",
        providerID: "opencode-go",
        capabilities: { tools: true, input: ["text", "image"], output: ["text"] },
        variants: [{ id: "high" }, { id: "low" }],
      }, {
        id: "minimal", modelID: "minimal", providerID: "opencode-go",
        capabilities: { tools: false, input: ["text"], output: ["text"] }, variants: [],
      }],
    });
  } else if (request.method === "GET" && url.pathname === "/api/model/default") {
    const directory = url.searchParams.get("location[directory]") ?? "";
    json(response, 200, {
      location: { directory },
      data: { id: "deepseek-v4.1-flash", modelID: "deepseek-v4.1-flash",
        providerID: "opencode-go",
        capabilities: { tools: true,
          input: process.env.MUHA_V2_IMAGE_MODEL === "text-only" ? ["text"] : ["text", "image"],
          output: ["text"] },
        variants: [{ id: "high" }, { id: "low" }] },
    });
  } else if (request.method === "POST" && /^\/api\/session\/[^/]+\/model$/.test(url.pathname)) {
    const id = decodeURIComponent(url.pathname.split("/")[3]);
    const session = sessions.get(id);
    if (!session) json(response, 404, { _tag: "SessionNotFoundError", sessionID: id });
    else {
      const body = JSON.parse(await readBody(request));
      session.model = body.model;
      response.writeHead(204).end();
    }
  } else if (request.method === "POST" && /^\/api\/session\/[^/]+\/interrupt$/.test(url.pathname)) {
    const id = decodeURIComponent(url.pathname.split("/")[3]);
    const session = sessions.get(id);
    if (!session) json(response, 404, { error: "not found" });
    else {
      session.interrupted = true;
      evidence.interrupts.push(id);
      emit(session, "session.execution.interrupted", {});
      for (const [requestID, waiting] of pendingPermissions) {
        if (waiting.session !== session) continue;
        pendingPermissions.delete(requestID);
        waiting.resolve();
      }
      for (const [formID, waiting] of pendingForms) {
        if (waiting.session !== session) continue;
        pendingForms.delete(formID);
        waiting.resolve();
      }
      json(response, 200, { interrupted: true });
    }
  } else if (request.method === "PATCH" && /^\/api\/session\/[^/]+$/.test(url.pathname)) {
    const id = decodeURIComponent(url.pathname.split("/")[3]);
    const session = sessions.get(id);
    if (!session) json(response, 404, { error: "not found" });
    else {
      const body = JSON.parse(await readBody(request));
      if (body.permissions !== undefined) session.permissions = body.permissions;
      response.writeHead(204).end();
    }
  } else if (request.method === "POST" && /^\/api\/session\/[^/]+\/permission\/[^/]+\/reply$/.test(url.pathname)) {
    const id = decodeURIComponent(url.pathname.split("/")[3]);
    const requestID = decodeURIComponent(url.pathname.split("/")[5]);
    const waiting = pendingPermissions.get(requestID);
    if (!waiting || waiting.session.id !== id) json(response, 404, { error: "not found" });
    else {
      const body = JSON.parse(await readBody(request));
      if (!(["once", "reject"].includes(body.decision))) json(response, 400, { error: "bad decision" });
      else {
        evidence.permissions.push({ sessionID: id, requestID, decision: body.decision });
        emit(waiting.session, "permission.replied", { requestID, reply: body.decision }, false);
        pendingPermissions.delete(requestID);
        waiting.resolve();
        response.writeHead(204).end();
      }
    }
  } else if (request.method === "POST" && /^\/api\/session\/[^/]+\/form\/[^/]+\/reply$/.test(url.pathname)) {
    const id = decodeURIComponent(url.pathname.split("/")[3]);
    const formID = decodeURIComponent(url.pathname.split("/")[5]);
    const waiting = pendingForms.get(formID);
    if (!waiting || waiting.session.id !== id) json(response, 404, { error: "not found" });
    else {
      const body = JSON.parse(await readBody(request));
      if (process.env.MUHA_V2_FORM_REJECT_ONCE && !rejectedForms.has(formID)) {
        rejectedForms.add(formID);
        json(response, 422, { error: "controlled native Form rejection" });
      } else {
        evidence.forms.push({ sessionID: id, formID, action: "answer", answer: body.answer });
        emit(waiting.session, "form.replied", { id: formID, answer: body.answer }, false);
        pendingForms.delete(formID);
        waiting.resolve();
        response.writeHead(204).end();
      }
    }
  } else if (request.method === "DELETE" && /^\/api\/session\/[^/]+\/form\/[^/]+$/.test(url.pathname)) {
    const id = decodeURIComponent(url.pathname.split("/")[3]);
    const formID = decodeURIComponent(url.pathname.split("/")[5]);
    const waiting = pendingForms.get(formID);
    if (!waiting || waiting.session.id !== id) json(response, 404, { error: "not found" });
    else {
      evidence.forms.push({ sessionID: id, formID, action: "dismiss" });
      emit(waiting.session, "form.cancelled", { id: formID }, false);
      pendingForms.delete(formID);
      waiting.resolve();
      response.writeHead(204).end();
    }
  } else if (request.method === "GET" && /^\/api\/session\/[^/]+$/.test(url.pathname)) {
    const id = decodeURIComponent(url.pathname.slice("/api/session/".length));
    const session = sessions.get(id);
    if (!session) json(response, 404, { _tag: "SessionNotFoundError", sessionID: id });
    else json(response, 200, { data: session });
  } else if (request.method === "GET" && /^\/api\/session\/[^/]+\/message$/.test(url.pathname)) {
    const id = decodeURIComponent(url.pathname.split("/")[3]);
    const session = sessions.get(id);
    if (!session) json(response, 404, { error: "not found" });
    else if (process.env.MUHA_V2_MESSAGE_PAGES === "two" && session.messages.length > 0) {
      const cursor = url.searchParams.get("cursor");
      if (cursor && url.searchParams.has("order")) {
        json(response, 400, { _tag: "InvalidCursorError", message: "Cursor cannot be combined with order" });
      } else if (cursor === null) {
        json(response, 200, { data: session.messages.slice(-1), cursor: { next: "older" } });
      } else {
        json(response, 200, { data: session.messages.slice(0, -1), cursor: {} });
      }
    } else json(response, 200, { data: session.messages, cursor: {} });
  } else if (request.method === "GET" && /^\/api\/session\/[^/]+\/message\/[^/]+$/.test(url.pathname)) {
    const id = decodeURIComponent(url.pathname.split("/")[3]);
    const messageID = decodeURIComponent(url.pathname.split("/")[5]);
    const message = sessions.get(id)?.messages.find((item) => item.id === messageID);
    if (!message) json(response, 404, { error: "not found" });
    else json(response, 200, { data: message });
  } else if (request.method === "POST" && /^\/api\/session\/[^/]+\/prompt$/.test(url.pathname)) {
    const id = decodeURIComponent(url.pathname.split("/")[3]);
    const session = sessions.get(id);
    if (!session) json(response, 404, { error: "not found" });
    else {
      const body = JSON.parse(await readBody(request));
      if (process.env.MUHA_V2_PROMPT_REJECT === "all" ||
          (process.env.MUHA_V2_PROMPT_REJECT === "image" && Array.isArray(body.files) && body.files.length > 0)) {
        json(response, 400, { error: "controlled prompt rejection" });
        await persistEvidence();
        return;
      }
      const inboxID = body.id ?? "msg_" + nextMessage++;
      if (!/^msg_/.test(inboxID)) return json(response, 400, { error: "invalid message id" });
      const inbox = {
        id: inboxID,
        sessionID: id,
        time: { created: Date.now() },
        type: "user",
        payload: { text: body.text },
        delivery: "steer",
      };
      session.interrupted = false;
      evidence.prompts.push({ sessionID: id, text: body.text, files: body.files,
        metadata: body.metadata, model: session.model });
