function emit(session, type, payload, volatile = false, offset) {
  if (!volatile) session.seq += 1;
  const frame = {
    type,
    seq: session.seq,
    epoch: "fake-epoch",
    ...(volatile ? { volatile: true } : {}),
    ...(offset === undefined ? {} : { offset }),
    session_id: session.id,
    timestamp: new Date().toISOString(),
    payload,
  };
  if (!volatile) session.journal.push(frame);
  for (const connection of session.subscribers) send(connection, frame);
}

function send(connection, value) {
  connection.socket.write(serverFrame(Buffer.from(JSON.stringify(value))));
}

function serverFrame(payload, opcode = 0x1) {
  if (payload.length < 126) return Buffer.concat([Buffer.from([0x80 | opcode, payload.length]), payload]);
  if (payload.length <= 0xffff) {
    const header = Buffer.alloc(4);
    header[0] = 0x80 | opcode;
    header[1] = 126;
    header.writeUInt16BE(payload.length, 2);
    return Buffer.concat([header, payload]);
  }
  const header = Buffer.alloc(10);
  header[0] = 0x80 | opcode;
  header[1] = 127;
  header.writeBigUInt64BE(BigInt(payload.length), 2);
  return Buffer.concat([header, payload]);
}

function removeConnection(connection) {
  sockets.delete(connection);
  for (const id of connection.subscriptions) sessions.get(id)?.subscribers.delete(connection);
}

function ensureWorkspace(root) {
  let workspace = workspaces.get(root);
  if (!workspace) {
    workspace = { id: `ws_fake_${nextWorkspace++}`, root };
    workspaces.set(root, workspace);
  }
  return workspace;
}

function publicSession(session) {
  return {
    id: session.id,
    workspace_id: session.workspace.id,
    title: session.title,
    created_at: new Date(session.createdAt).toISOString(),
    updated_at: new Date(session.updatedAt).toISOString(),
    busy: false,
    metadata: { cwd: session.workspace.root },
    agent_config: { model: session.model ?? "" },
  };
}

function validContentPart(part) {
  if (part?.type === "text") return typeof part.text === "string";
  return part?.type === "image" &&
    part.source?.kind === "base64" &&
    typeof part.source.media_type === "string" &&
    typeof part.source.data === "string";
}

async function shutdown() {
  for (const connection of sockets) connection.socket.destroy();
  sockets.clear();
  server.closeAllConnections();
  server.close(() => process.exit(0));
}

async function readJson(request) {
  let source = "";
  for await (const chunk of request) source += chunk;
  return source.length === 0 ? {} : JSON.parse(source);
}

function envelope(data, code = 0, msg = "success") {
  return { code, msg, data, request_id: `req_${Date.now()}` };
}

function json(response, status, value) {
  response.writeHead(status, { "content-type": "application/json" });
  response.end(JSON.stringify(value));
}

async function persistEvidence() {
  if (evidenceFile) await writeFile(evidenceFile, JSON.stringify(evidence));
}

async function persistSessions() {
  if (!sessionsFile) return;
  await writeFile(sessionsFile, JSON.stringify([...sessions.values()].map((session) => ({
    id: session.id,
    workspacePath: session.workspace.root,
    title: session.title,
    createdAt: session.createdAt,
    updatedAt: session.updatedAt,
    ...(session.model ? { model: session.model } : {}),
  }))));
}
