function validPromptPart(part) {
  if (!part || typeof part !== "object") return false;
  if (part.type === "text") return typeof part.text === "string" && part.text.length > 0;
  return part.type === "file" &&
    ["image/png", "image/jpeg", "image/webp", "image/gif"].includes(part.mime) &&
    typeof part.url === "string" &&
    (part.url.startsWith("file:") || (
      part.url.startsWith(`data:${part.mime};base64,`) &&
      part.url.length > `data:${part.mime};base64,`.length
    ));
}

function parseModel(model) {
  if (typeof model !== "string") return undefined;
  const slash = model.indexOf("/");
  if (slash < 1 || slash === model.length - 1) return undefined;
  return { providerID: model.slice(0, slash), modelID: model.slice(slash + 1) };
}

function publicSession(session) {
  const { model: _model, ...value } = session;
  return value;
}

function emit(directory, event) {
  for (const stream of streams) {
    if (stream.directory === directory) emitTo(stream, event);
  }
}

function emitTo(stream, event) {
  stream.response.write(`event: message\ndata: ${JSON.stringify({ id: `evt_${nextEventId++}`, ...event })}\n\n`);
}

async function disconnectStreams(directory) {
  const matches = [...streams].filter((stream) => stream.directory === directory);
  if (matches.length === 0) return;
  evidence.streamDisconnects += matches.length;
  for (const stream of matches) stream.response.destroy();
  await persistEvidence();
}

async function readJson(request) {
  let source = "";
  for await (const chunk of request) source += chunk;
  return source.length === 0 ? {} : JSON.parse(source);
}

function json(response, status, value, headers = {}) {
  response.writeHead(status, { "content-type": "application/json", ...headers });
  response.end(JSON.stringify(value));
}

async function persistEvidence() {
  if (evidenceFile) await writeFile(evidenceFile, JSON.stringify(evidence));
}

async function persistSessions() {
  if (!sessionsFile) return;
  await writeFile(sessionsFile, JSON.stringify([...sessions.values()].map((session) => ({
    id: session.id,
    directory: session.directory,
    title: session.title,
    createdAt: session.time.created,
    updatedAt: session.time.updated,
    ...(session.model ? { model: session.model } : {}),
  }))));
}
