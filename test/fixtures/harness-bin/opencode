#!/usr/bin/env node
import { createServer } from "node:http";
import { readFile, writeFile } from "node:fs/promises";

const expectedArgs = ["serve", "--hostname", "127.0.0.1", "--port", "0", "--no-mdns"];
if (JSON.stringify(process.argv.slice(2)) !== JSON.stringify(expectedArgs)) {
  process.stderr.write("unexpected OpenCode arguments\n");
  process.exit(64);
}

const scenario = process.env.MUHA_FAKE_OPENCODE_SCENARIO ?? "normal";
if (scenario === "early-exit") process.exit(42);
const username = process.env.OPENCODE_SERVER_USERNAME;
const password = process.env.OPENCODE_SERVER_PASSWORD;
if (username !== "opencode" || typeof password !== "string") process.exit(65);
let passwordBytes;
try {
  passwordBytes = Buffer.from(password, "base64url").length;
} catch {
  process.exit(65);
}
if (passwordBytes !== 32) process.exit(65);

const expectedAuthorization = `Basic ${Buffer.from(`${username}:${password}`).toString("base64")}`;
const evidenceFile = process.env.MUHA_FAKE_OPENCODE_EVIDENCE_FILE;
const pidFile = process.env.MUHA_FAKE_PID_FILE;
const sessionsFile = process.env.MUHA_FAKE_OPENCODE_SESSIONS_FILE;
const pageSize = Number(process.env.MUHA_FAKE_OPENCODE_PAGE_SIZE ?? Number.MAX_SAFE_INTEGER);
const tlsFailureCount = Number(process.env.MUHA_FAKE_OPENCODE_TLS_FAILURES ?? "1");
const emptyFinalFailureCount = Number(process.env.MUHA_FAKE_OPENCODE_EMPTY_FINAL_FAILURES ?? "1");
const evidence = {
  argv: process.argv.slice(2),
  username,
  passwordBytes,
  inheritedCredentialOverridden:
    password !== "caller-password" && username !== "caller-username",
  requests: [],
  prompts: [],
  permissionReplies: [],
  questionResponses: [],
  aborts: [],
  unauthorizedRequests: 0,
  streamConnections: 0,
  streamDisconnects: 0,
};
const sessions = new Map();
const streams = new Set();
const pendingPermissions = new Map();
const pendingQuestions = new Map();
let nextEventId = 1;
let nextSessionId = 1;

if (sessionsFile) {
  try {
    const seeded = JSON.parse(await readFile(sessionsFile, "utf8"));
    if (!Array.isArray(seeded)) process.exit(67);
    for (const value of seeded) {
      if (!value || typeof value.id !== "string" || typeof value.directory !== "string") process.exit(67);
      sessions.set(value.id, {
        id: value.id,
        projectID: "fake-project",
        directory: value.directory,
        title: typeof value.title === "string" ? value.title : "",
        version: "fake-opencode",
        ...(typeof value.parentID === "string" ? { parentID: value.parentID } : {}),
        time: {
          created: Number.isSafeInteger(value.createdAt) ? value.createdAt : Date.now(),
          updated: Number.isSafeInteger(value.updatedAt) ? value.updatedAt : Date.now(),
        },
        ...(typeof value.model === "string" ? { model: value.model } : {}),
      });
    }
  } catch (error) {
    if (error?.code !== "ENOENT") process.exit(67);
  }
}

await persistEvidence();
if (pidFile) await writeFile(pidFile, String(process.pid));
if (scenario === "unready") {
  setInterval(() => undefined, 1_000);
} else {
  const server = createServer(async (request, response) => {
    try {
      if (request.headers.authorization !== expectedAuthorization) {
        evidence.unauthorizedRequests += 1;
        await persistEvidence();
        response.writeHead(401).end();
        return;
      }
      const url = new URL(request.url ?? "/", "http://127.0.0.1");
      const directory = request.headers["x-opencode-directory"];
      evidence.requests.push({
        method: request.method,
        path: url.pathname,
        query: url.search,
        directory: typeof directory === "string" ? directory : null,
        authenticated: true,
      });
      await persistEvidence();

      if (request.method === "GET" && url.pathname === "/global/health") {
        if (scenario === "health-malformed") return json(response, 200, { healthy: "yes" });
        if (scenario === "health-unhealthy") return json(response, 503, { healthy: false });
        return json(response, 200, { healthy: true, version: "fake-opencode" });
      }
      if (request.method === "GET" && url.pathname === "/event") {
        if (typeof directory !== "string" || directory.length === 0) return json(response, 400, {});
        evidence.streamConnections += 1;
        await persistEvidence();
        response.writeHead(200, {
          "content-type": "text/event-stream",
          "cache-control": "no-cache",
          connection: "keep-alive",
        });
        const stream = { directory, response };
        streams.add(stream);
        request.once("close", () => streams.delete(stream));
        emitTo(stream, { type: "server.connected", properties: {} });
        if (scenario === "accept-race-disconnect" && evidence.streamConnections === 2) {
          evidence.streamDisconnects += 1;
          response.end();
          streams.delete(stream);
          await persistEvidence();
        }
        return;
      }
      if (request.method === "GET" && url.pathname === "/provider") {
        if (typeof directory !== "string" || directory.length === 0) return json(response, 400, {});
        if (scenario === "selection-disconnect" && evidence.streamDisconnects === 0) {
          await disconnectStreams(directory);
        }
        return json(response, 200, {
          all: [
            {
              id: "fake-provider",
              name: "Fake Provider",
              models: {
                "fake-model": { id: "fake-model" },
                "fake-high": { id: "fake-high", variants: { max: { reasoningEffort: "max" } } },
              },
            },
            {
              id: "Fake.Provider",
              name: "Lossless Provider",
              models: { "model/with/slashes": { id: "model/with/slashes" } },
            },
            {
              id: "opencode-go",
              name: "OpenCode Go Fixture",
              models: { "fake-tool-model": { id: "fake-tool-model" } },
            },
          ],
          default: { "fake-provider": "fake-model" },
          connected: ["fake-provider", "Fake.Provider"],
        });
      }
      const permissionReply = url.pathname.match(/^\/permission\/([^/]+)\/reply$/);
      if (request.method === "POST" && permissionReply) {
        const requestId = decodeURIComponent(permissionReply[1]);
        const pending = pendingPermissions.get(requestId);
        if (!pending || directory !== pending.session.directory) return json(response, 404, {});
        const body = await readJson(request);
        if (body.reply !== "once" && body.reply !== "reject") return json(response, 400, {});
        evidence.permissionReplies.push({ requestId, reply: body.reply });
        pendingPermissions.delete(requestId);
        await persistEvidence();
        emit(pending.session.directory, {
          type: "permission.replied",
          properties: { sessionID: pending.session.id, requestID: requestId, reply: body.reply },
        });
        if (pending.finish) {
          setTimeout(pending.finish, 2);
          return json(response, 200, true);
        }
        setTimeout(
          () => scenario === "reused-tool-call-id"
            ? emitReusedToolQuestion(pending.session)
            : scenario === "early-tool-interactions"
              ? emitEarlyToolQuestion(pending.session)
            : emitRichQuestion(pending.session),
          2,
        );
        return json(response, 200, true);
      }
      const questionReply = url.pathname.match(/^\/question\/([^/]+)\/reply$/);
      if (request.method === "POST" && questionReply) {
        const requestId = decodeURIComponent(questionReply[1]);
        const pending = pendingQuestions.get(requestId);
        if (!pending || directory !== pending.session.directory) return json(response, 404, {});
        const body = await readJson(request);
        if (!Array.isArray(body.answers)) return json(response, 400, {});
        evidence.questionResponses.push({ requestId, action: "answer", answers: body.answers });
        pendingQuestions.delete(requestId);
        await persistEvidence();
        emit(pending.session.directory, {
          type: "question.replied",
          properties: { sessionID: pending.session.id, requestID: requestId, answers: body.answers },
        });
        setTimeout(
          () => scenario === "reused-tool-call-id"
            ? finishReusedToolCallTurn(pending.session)
            : scenario === "early-tool-interactions"
              ? finishEarlyToolInteractionTurn(pending.session)
            : finishRichTurn(pending.session, false),
          50,
        );
        return json(response, 200, true);
      }
      const questionReject = url.pathname.match(/^\/question\/([^/]+)\/reject$/);
      if (request.method === "POST" && questionReject) {
        const requestId = decodeURIComponent(questionReject[1]);
        const pending = pendingQuestions.get(requestId);
        if (!pending || directory !== pending.session.directory) return json(response, 404, {});
        pendingQuestions.delete(requestId);
        evidence.questionResponses.push({ requestId, action: "dismiss" });
        await persistEvidence();
        emit(pending.session.directory, {
          type: "question.rejected",
          properties: { sessionID: pending.session.id, requestID: requestId },
        });
        setTimeout(
          () => scenario === "reused-tool-call-id"
            ? finishReusedToolCallTurn(pending.session)
            : scenario === "early-tool-interactions"
              ? finishEarlyToolInteractionTurn(pending.session)
            : finishRichTurn(pending.session, true),
          50,
        );
        return json(response, 200, true);
      }
      if (request.method === "GET" && url.pathname === "/session") {
        if (typeof directory !== "string" || directory.length === 0) return json(response, 400, {});
        const cursor = Number(url.searchParams.get("cursor") ?? "0");
        if (!Number.isSafeInteger(cursor) || cursor < 0) return json(response, 400, {});
        const matches = scenario === "global-list"
          ? [...sessions.values()]
          : [...sessions.values()].filter((session) => session.directory === directory);
        const size = Number.isSafeInteger(pageSize) && pageSize > 0 ? pageSize : matches.length;
        const page = matches.slice(cursor, cursor + size).map(publicSession);
        const next = cursor + page.length < matches.length ? String(cursor + page.length) : undefined;
        return json(response, 200, page, next ? { "x-next-cursor": next } : undefined);
      }
      if (request.method === "POST" && url.pathname === "/session") {
        if (typeof directory !== "string" || directory.length === 0) return json(response, 400, {});
        await readJson(request);
        if (scenario === "create-malformed") return json(response, 200, { id: 1 });
        const now = Date.now();
        const session = {
          id: `ses_fake_${nextSessionId++}`,
          projectID: "fake-project",
          directory,
          title: "New session",
          version: "fake-opencode",
          time: { created: now, updated: now },
        };
        sessions.set(session.id, session);
        await persistSessions();
        emit(directory, { type: "session.created", properties: { info: session } });
        if (
          (scenario === "idle-disconnect" || scenario === "accept-race-disconnect") &&
          evidence.streamDisconnects === 0
        ) {
          setTimeout(() => void disconnectStreams(directory), 2);
        }
        return json(response, 200, publicSession(session));
      }
      const getSession = url.pathname.match(/^\/session\/([^/]+)$/);
      const children = url.pathname.match(/^\/session\/([^/]+)\/children$/);
      if (request.method === "GET" && children) {
        const parentID = decodeURIComponent(children[1]);
        return json(response, 200, [...sessions.values()]
          .filter((session) => session.parentID === parentID && session.directory === directory).map(publicSession));
      }
      if (request.method === "GET" && getSession) {
        const session = sessions.get(decodeURIComponent(getSession[1]));
        if (!session || (scenario !== "resume-alias" && directory !== session.directory)) {
          return json(response, 404, {});
        }
        return json(response, 200, publicSession(session));
      }
      const messages = url.pathname.match(/^\/session\/([^/]+)\/message$/);
      if (request.method === "GET" && messages) {
        const session = sessions.get(decodeURIComponent(messages[1]));
        if (!session || (scenario !== "resume-alias" && directory !== session.directory)) {
          return json(response, 404, {});
        }
        if (!session.model) return json(response, 200, []);
        const [providerID, ...modelParts] = session.model.split("/");
        return json(response, 200, [{
          info: {
            id: `msg_historical_${session.id}`,
            sessionID: session.id,
            role: "user",
            time: { created: session.time.updated },
            agent: "build",
            model: { providerID, modelID: modelParts.join("/") },
          },
          parts: [],
        }]);
      }
      const prompt = url.pathname.match(/^\/session\/([^/]+)\/prompt_async$/);
      if (request.method === "POST" && prompt) {
        const session = sessions.get(decodeURIComponent(prompt[1]));
        if (!session || directory !== session.directory) return json(response, 404, {});
        const body = await readJson(request);
        if (!body || !Array.isArray(body.parts) || body.parts.length === 0) return json(response, 400, {});
        if (!body.parts.every(validPromptPart)) return json(response, 400, {});
        if (scenario === "prompt-reject") return json(response, 400, { name: "BadRequest" });
        if (scenario === "image-reject" && body.parts.some(({ type }) => type === "file")) {
          return json(response, 400, { name: "ImageNotSupported" });
        }
        evidence.prompts.push({ sessionID: session.id, model: body.model ?? null, variant: body.variant ?? null, parts: body.parts });
        const selected = body.model ?? parseModel(session.model) ?? {
          providerID: "fake-provider",
          modelID: "fake-model",
        };
        session.model = `${selected.providerID}/${selected.modelID}`;
        session.time.updated = Date.now();
        await Promise.all([persistEvidence(), persistSessions()]);
        response.writeHead(204).end();
        setTimeout(
          () => {
            if (scenario === "child-approval") emitChildApproval(session, { ...body, model: selected });
            else if (scenario === "session-error") emitSessionError(session, selected, false);
            else if (scenario === "session-error-retryable") emitSessionError(session, selected, true);
            else if (scenario === "transient-tls" && evidence.prompts.length <= tlsFailureCount) {
              emitTlsSessionError(session, selected);
            }
            else if (scenario === "reused-tool-call-id") {
              emitReusedToolCallTurn(session, { ...body, model: selected });
            } else if (scenario === "early-tool-interactions") {
              emitEarlyToolInteractionTurn(session, { ...body, model: selected });
            } else if (scenario === "duplicate-tool-snapshots") {
              emitDuplicateToolSnapshotsTurn(session, { ...body, model: selected });
            } else if (
              scenario === "completed-tool-update" ||
              scenario === "tool-part-identity-drift" ||
              scenario === "ambiguous-tool-reference"
            ) {
              emitIllegalToolIdentityTurn(session, { ...body, model: selected }, scenario);
            } else if (
              scenario === "rich" ||
              scenario === "abort-event-race" ||
              scenario === "abort-event-rejected"
            ) {
              emitRichTurn(session, { ...body, model: selected });
            } else if (scenario === "reasoning-only") {
              emitReasoningOnlyTurn(session, { ...body, model: selected });
            } else if (
              scenario === "empty-final-then-text" &&
              evidence.prompts.length <= emptyFinalFailureCount
            ) {
              emitReasoningOnlyTurn(session, { ...body, model: selected });
            } else if (scenario === "whitespace-final") {
              emitTextTurn(session, { ...body, model: selected, finalText: " \n\t" });
            } else if (scenario === "empty-intermediate" || scenario === "cumulative-usage") {
              emitTextTurn(session, { ...body, model: selected, emptyIntermediate: true, duplicateIntermediate: scenario === "cumulative-usage" });
            } else if (scenario === "nonempty-intermediate-empty-final") {
              emitTextTurn(session, { ...body, model: selected, intermediateText: "Intermediate.", finalText: "" });
            } else if (scenario === "active-disconnect") {
              emitRichTurn(session, { ...body, model: selected });
              emitRichQuestion(session);
              setTimeout(() => void disconnectStreams(session.directory), 2);
            } else emitTextTurn(session, { ...body, model: selected });
          },
          5,
        );
        return;
      }
      const abort = url.pathname.match(/^\/session\/([^/]+)\/abort$/);
      if (request.method === "POST" && abort) {
        const session = sessions.get(decodeURIComponent(abort[1]));
        if (!session || directory !== session.directory) return json(response, 404, {});
        evidence.aborts.push({ sessionID: session.id });
        await persistEvidence();
        if (scenario === "abort-event-race" || scenario === "abort-event-rejected") {
          emit(session.directory, {
            type: "session.error",
            properties: {
              sessionID: session.id,
              error: { name: "MessageAbortedError", data: { message: "Aborted" } },
            },
          });
          await new Promise((resolve) => setTimeout(resolve, 25));
          if (scenario === "abort-event-rejected") return json(response, 409, false);
        }
        return json(response, 200, true);
      }
      json(response, 404, {});
    } catch {
      json(response, 500, {});
    }
  });

  server.listen(0, "127.0.0.1", () => {
    const address = server.address();
    if (!address || typeof address === "string") process.exit(66);
    const line = scenario === "bad-ready-line"
      ? `server available on http://127.0.0.1:${address.port}`
      : `opencode server listening on http://127.0.0.1:${address.port}`;
    process.stdout.write(`${line}\n`);
  });

  process.once("SIGTERM", shutdown);
  process.once("SIGINT", shutdown);
  async function shutdown() {
    for (const stream of streams) stream.response.destroy();
    streams.clear();
    server.closeAllConnections();
    server.close(() => process.exit(0));
  }
}

function emitSessionError(session, model, retryable) {
  const userMessageId = `msg_user_${session.id}`;
  const assistantMessageId = `msg_assistant_${session.id}`;
  const now = Date.now();
  emit(session.directory, {
    type: "message.updated",
    properties: {
      info: {
        id: userMessageId,
        sessionID: session.id,
        role: "user",
        time: { created: now },
        agent: "build",
        model,
      },
    },
  });
  emit(session.directory, {
    type: "message.updated",
    properties: {
      info: {
        id: assistantMessageId,
        sessionID: session.id,
        role: "assistant",
        time: { created: now + 1 },
        parentID: userMessageId,
        modelID: model.modelID,
        providerID: model.providerID,
      },
    },
  });
  emit(session.directory, {
    type: "session.error",
    properties: {
      sessionID: session.id,
      error: {
        name: "APIError",
        data: {
          message: "Invalid API Key",
          statusCode: 401,
          isRetryable: retryable,
          responseBody: "sensitive body must not escape",
        },
      },
    },
  });
}

function emitTlsSessionError(session, model) {
  const userMessageId = `msg_user_${session.id}`;
  const assistantMessageId = `msg_assistant_${session.id}`;
  const now = Date.now();
  emit(session.directory, {
    type: "message.updated",
    properties: {
      info: {
        id: userMessageId,
        sessionID: session.id,
        role: "user",
        time: { created: now },
        agent: "build",
        model,
      },
    },
  });
  emit(session.directory, {
    type: "message.updated",
    properties: {
      info: {
        id: assistantMessageId,
        sessionID: session.id,
        role: "assistant",
        time: { created: now + 1 },
        parentID: userMessageId,
        modelID: model.modelID,
        providerID: model.providerID,
      },
    },
  });
  emit(session.directory, {
    type: "session.error",
    properties: {
      sessionID: session.id,
      error: {
        name: "UnknownError",
        data: { message: "unknown certificate verification error" },
      },
    },
  });
}

function emitChildApproval(session, body) {
  emit(session.directory, { type: "message.updated", properties: { info: {
    id: `msg_user_${session.id}`, sessionID: session.id, role: "user", model: body.model,
  } } });
  let child = session;
  if (!body.parts.some((part) => part.text === "peer")) {
    for (const suffix of ["_child", "_grandchild"]) {
      const id = session.id + suffix;
      let next = sessions.get(id);
      if (!next) {
        next = { ...publicSession(session), id, parentID: child.id };
        sessions.set(id, next);
        emit(session.directory, { type: "session.created", properties: { info: next } });
      }
      child = next;
    }
  }
  const requestId = `perm_${child.id}_${nextEventId}`;
  pendingPermissions.set(requestId, { session: child, finish: () => emitTextTurn(session, body) });
  emit(session.directory, { type: "permission.asked", properties: {
    id: requestId, sessionID: child.id, permission: "bash", patterns: ["echo approved"], metadata: {},
  } });
}

function emitTextTurn(session, body) {
  const model = body.model ?? { providerID: "fake-provider", modelID: "fake-model" };
  const userMessageId = `msg_user_${session.id}`;
  const assistantMessageId = `msg_assistant_${session.id}`;
  const now = Date.now();
  emit(session.directory, {
    type: "message.updated",
    properties: {
      info: {
        id: userMessageId,
        sessionID: session.id,
        role: "user",
        time: { created: now },
        agent: "build",
        model,
      },
    },
  });
  emitUserTextPart(session, userMessageId);
  emit(session.directory, {
    type: "session.status",
    properties: { sessionID: session.id, status: { type: "busy" } },
  });
  if (body.emptyIntermediate === true || body.intermediateText !== undefined) {
    const intermediate = {
      id: `msg_assistant_intermediate_${session.id}`,
      sessionID: session.id,
      role: "assistant",
      time: { created: now + 1 },
      parentID: userMessageId,
      modelID: model.modelID,
      providerID: model.providerID,
      mode: "build",
      path: { cwd: session.directory, root: session.directory },
      cost: 0,
      tokens: { input: 4, output: 0, reasoning: 2, cache: { read: 0, write: 0 } },
    };
    emit(session.directory, {
      type: "message.updated",
      properties: { info: intermediate },
    });
    if (body.intermediateText !== undefined) {
      emit(session.directory, {
        type: "message.part.updated",
        properties: {
          part: {
            id: `part_intermediate_text_${session.id}`,
            sessionID: session.id,
            messageID: intermediate.id,
            type: "text",
            text: body.intermediateText,
          },
          delta: body.intermediateText,
        },
      });
    }
    const completedIntermediate = {
      type: "message.updated",
      properties: {
        info: { ...intermediate, time: { ...intermediate.time, completed: now + 2 }, finish: "tool-call" },
      },
    };
    emit(session.directory, completedIntermediate);
    if (body.duplicateIntermediate) emit(session.directory, completedIntermediate);
  }
  const assistant = {
    id: assistantMessageId,
    sessionID: session.id,
    role: "assistant",
    time: { created: now + 1 },
    parentID: userMessageId,
    modelID: model.modelID,
    providerID: model.providerID,
    mode: "build",
    path: { cwd: session.directory, root: session.directory },
    cost: 0,
    tokens: { input: 4, output: 3, reasoning: 0, cache: { read: 1, write: 0 } },
  };
  emit(session.directory, {
    type: "message.updated",
    properties: { info: assistant },
  });
  const text = body.finalText ?? "Hello from OpenCode.";
  emit(session.directory, {
    type: "message.part.updated",
    properties: {
      part: {
        id: `part_text_${session.id}`,
        sessionID: session.id,
        messageID: assistantMessageId,
        type: "text",
        text,
      },
      delta: text,
    },
  });
  emit(session.directory, {
    type: "message.updated",
    properties: {
      info: { ...assistant, time: { ...assistant.time, completed: now + 2 }, finish: "stop" },
    },
  });
  emit(session.directory, {
    type: "session.status",
    properties: { sessionID: session.id, status: { type: "idle" } },
  });
}

function emitReasoningOnlyTurn(session, body) {
  const model = body.model ?? { providerID: "fake-provider", modelID: "fake-model" };
  const userMessageId = `msg_user_${session.id}`;
  const assistantMessageId = `msg_assistant_${session.id}`;
  const now = Date.now();
  emit(session.directory, {
    type: "message.updated",
    properties: {
      info: {
        id: userMessageId,
        sessionID: session.id,
        role: "user",
        time: { created: now },
        agent: "build",
        model,
      },
    },
  });
  emitUserTextPart(session, userMessageId);
  emit(session.directory, {
    type: "session.status",
    properties: { sessionID: session.id, status: { type: "busy" } },
  });
  const assistant = {
    id: assistantMessageId,
