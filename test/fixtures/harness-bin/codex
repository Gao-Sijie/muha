function emitTerminalScenario(scenario, threadId, turn) {
  sendNotification("turn/started", { threadId, turn });
  if (scenario === "protocol-assistant-delta-without-start") {
    sendNotification("item/agentMessage/delta", {
      threadId,
      turnId: turn.id,
      itemId: "message_never_started",
      delta: "invalid",
    });
  }
  if (scenario === "protocol-assistant-duplicate-completion") {
    const message = agentMessage("message_duplicate", "done");
    sendNotification("item/started", {
      item: { ...message, text: "" }, threadId, turnId: turn.id, startedAtMs: 1,
    });
    sendNotification("item/completed", { item: message, threadId, turnId: turn.id, completedAtMs: 2 });
    sendNotification("item/completed", { item: message, threadId, turnId: turn.id, completedAtMs: 3 });
  }
  if (scenario === "protocol-tool-completion-without-start") {
    sendNotification("item/completed", {
      threadId,
      turnId: turn.id,
      completedAtMs: 2,
      item: {
        type: "commandExecution",
        id: "tool_never_started",
        command: "true",
        cwd: globalThis.__muhaLastWorkspacePath,
        status: "completed",
        commandActions: [],
        aggregatedOutput: "",
        exitCode: 0,
        durationMs: 1,
      },
    });
  }
  if (scenario === "native-failed") {
    turn.status = "failed";
    turn.error = { message: "native fixture failure" };
    sendNotification("turn/completed", { threadId, turn });
    return;
  }
  if (scenario === "native-interrupted") {
    turn.status = "interrupted";
    sendNotification("turn/completed", { threadId, turn });
    return;
  }
  turn.status = "completed";
  turn.completedAt = 2;
  turn.durationMs = 1;
  sendNotification("turn/completed", { threadId, turn });
}

function usage(inputTokens, outputTokens, cachedInputTokens, reasoningOutputTokens) {
  const last = {
    totalTokens: inputTokens + outputTokens,
    inputTokens,
    cachedInputTokens,
    cacheWriteInputTokens: 0,
    outputTokens,
    reasoningOutputTokens,
  };
  const total = {
    totalTokens: last.totalTokens + 150,
    inputTokens: last.inputTokens + 100,
    cachedInputTokens: last.cachedInputTokens + 30,
    cacheWriteInputTokens: 0,
    outputTokens: last.outputTokens + 50,
    reasoningOutputTokens: last.reasoningOutputTokens + 20,
  };
  return { total, last, modelContextWindow: 1000 };
}

function agentMessage(id, text) {
  return { type: "agentMessage", id, text, phase: "final_answer", memoryCitation: null };
}

function sendNotification(method, params) {
  process.stdout.write(`${JSON.stringify({ method, params })}\n`);
}
