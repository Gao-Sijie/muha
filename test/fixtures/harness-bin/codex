#!/usr/bin/env node

import { createInterface } from "node:readline";
import { readFile, rename, writeFile } from "node:fs/promises";
import { spawn } from "node:child_process";

const threadTurns = new Map();
const loadedPolicies = new Map();

if (!["app-server --stdio", "app-server --stdio -c thread_unload_delay_secs=0"].includes(process.argv.slice(2).join(" "))) {
  process.stderr.write("unexpected fake Codex arguments\n");
  process.exitCode = 64;
} else {
  const lines = createInterface({ input: process.stdin });

  let initialized = false;
  let keepAlive;
  let activeTurn;
  let activeTurnThreadId;
  let activeApproval;
  let activeQuestion;
  let activeElicitation;
  const elicitationResponses = [];
  let turnRequestCount = 0;
  let interruptCount = 0;
  let resumeClosingObserved = false;
  for await (const line of lines) {
    const request = JSON.parse(line);
    if (
      activeElicitation &&
      request.id === activeElicitation.requests[activeElicitation.index].id &&
      request.method === undefined &&
      request.result !== undefined
    ) {
      elicitationResponses.push(request.result);
      const resolvedId = activeElicitation.requests[activeElicitation.index].id;
      sendNotification("serverRequest/resolved", {
        threadId: activeElicitation.threadId,
        requestId: resolvedId,
      });
      activeElicitation.index += 1;
      if (process.env.MUHA_FAKE_ELICITATION_RESPONSE_FILE) {
        await writeFile(
          process.env.MUHA_FAKE_ELICITATION_RESPONSE_FILE,
          JSON.stringify(elicitationResponses),
        );
      }
      if (activeElicitation.index < activeElicitation.requests.length) {
        sendElicitation(activeElicitation);
      } else {
        finishElicitationTurn(activeElicitation);
        activeElicitation = undefined;
      }
      continue;
    }
    if (
      activeQuestion &&
      request.id === activeQuestion.requestId &&
      request.method === undefined &&
      request.result !== undefined
    ) {
      if (process.env.MUHA_FAKE_QUESTION_RESPONSE_FILE) {
        await writeFile(
          process.env.MUHA_FAKE_QUESTION_RESPONSE_FILE,
          JSON.stringify(request.result),
        );
      }
      sendNotification("serverRequest/resolved", {
        threadId: activeQuestion.threadId,
        requestId: activeQuestion.requestId,
      });
      finishQuestionTurn(activeQuestion);
      activeQuestion = undefined;
      continue;
    }
    if (
      activeApproval &&
      request.id === activeApproval.requestId &&
      request.method === undefined &&
      request.result !== undefined
    ) {
      const decision = request.result.decision ?? request.result;
      if (process.env.MUHA_FAKE_APPROVAL_DECISION_FILE) {
        await writeFile(
          process.env.MUHA_FAKE_APPROVAL_DECISION_FILE,
          typeof decision === "string" ? decision : JSON.stringify(decision),
        );
      }
      sendNotification("serverRequest/resolved", {
        threadId: activeApproval.threadId,
        requestId: activeApproval.requestId,
      });
      finishApprovalTurn(activeApproval.threadId, activeApproval.turn, activeApproval.command);
      activeApproval = undefined;
      continue;
    }
    if (!initialized && request.method === "initialize") {
      if (typeof request.params?.clientInfo?.version !== "string") {
        process.stderr.write("unexpected Muha SDK version\n");
        process.exitCode = 69;
        break;
      }
      if ("experimentalApi" in (request.params ?? {})) {
        process.stderr.write("experimental API must remain disabled\n");
        process.exitCode = 66;
        break;
      }
      if (request.params.capabilities !== null) {
        process.stderr.write("MCP extended elicitation must remain disabled\n");
        process.exitCode = 68;
        break;
      }
      process.stdout.write(
        `${JSON.stringify({
          id: request.id,
          result: { harness: "codex", fixture: true },
        })}\n`,
      );
      continue;
    }
    if (!initialized && request.method === "initialized") {
      initialized = true;
      if (process.env.MUHA_FAKE_PID_FILE) {
        await writePid(process.env.MUHA_FAKE_PID_FILE, process.pid);
      }
      if (
        process.env.MUHA_FAKE_DESCENDANT_PID_FILE &&
        process.env.MUHA_FAKE_DESCENDANT_MARKER
      ) {
        const descendant = spawn(
          process.execPath,
          [
            "-e",
            "setInterval(() => undefined, 1000)",
            process.env.MUHA_FAKE_DESCENDANT_MARKER,
          ],
          { stdio: "ignore" },
        );
        descendant.unref();
        await writePid(process.env.MUHA_FAKE_DESCENDANT_PID_FILE, descendant.pid);
      }
      if (process.env.MUHA_FAKE_IGNORE_EOF === "1") {
        keepAlive = setInterval(() => undefined, 1_000);
      }
      continue;
    }
    if (!initialized) {
      process.stderr.write("unexpected fake Codex method\n");
      process.exitCode = 65;
      break;
    }
    if (request.method === "experimentalFeature/list") {
      if (typeof request.params?.threadId !== "string" || request.params.threadId.length === 0) {
        process.stdout.write(`${JSON.stringify({ id: request.id, error: {
          code: "invalid_request", message: "threadId is required for effective feature values",
        } })}\n`);
      } else if (process.env.MUHA_FAKE_CODEX_QUESTION_FEATURE === "unavailable") {
        process.stdout.write(`${JSON.stringify({ id: request.id, error: {
          code: "method_not_found", message: "feature list unavailable",
        } })}\n`);
      } else {
        process.stdout.write(`${JSON.stringify({ id: request.id, result: {
          data: [{ name: "default_mode_request_user_input",
            enabled: process.env.MUHA_FAKE_CODEX_QUESTION_FEATURE !== "disabled" }],
          nextCursor: null,
        } })}\n`);
      }
      continue;
    }
    if (request.method === "thread/start") {
      if (rejectUnexpectedSandbox(request)) continue;
      if (process.env.MUHA_FAKE_SESSION_REQUEST_FILE) {
        await writeFile(process.env.MUHA_FAKE_SESSION_REQUEST_FILE, JSON.stringify(request.params));
      }
      globalThis.__muhaLastWorkspacePath = request.params.cwd;
      const sessions = await readNativeSessions();
      const record = {
        id: `thread_fake_${sessions.length + 1}`,
        workspacePath: request.params.cwd,
        model: request.params.model ?? "fake-default",
      };
      sessions.push(record);
      loadedPolicies.set(record.id, { approvalPolicy: request.params.approvalPolicy, sandbox: request.params.sandbox });
      const thread = threadFromRecord(record);
      if (process.env.MUHA_FAKE_NATIVE_SESSIONS_FILE) {
        await writeNativeSessions(sessions);
      }
      process.stdout.write(
        `${JSON.stringify({
          id: request.id,
          result: {
            thread,
            model: record.model,
            modelProvider: "fake",
            serviceTier: null,
            cwd: request.params.cwd,
            instructionSources: [],
            approvalPolicy: request.params.approvalPolicy,
            approvalsReviewer: "user",
            sandbox: { type: process.env.MUHA_FAKE_TURN_SCENARIO !== "wrong-permission-mode" && request.params.sandbox === "danger-full-access" ? "dangerFullAccess" : "workspaceWrite" },
            reasoningEffort: null,
          },
        })}\n`,
      );
      process.stdout.write(`${JSON.stringify({ method: "thread/started", params: { thread } })}\n`);
      continue;
    }
    if (request.method === "thread/list") {
      const sessions = (await readNativeSessions()).filter(
        ({ workspacePath }) => workspacePath === request.params.cwd,
      );
      const offset = request.params.cursor === undefined ? 0 : Number(request.params.cursor);
      const page = sessions.slice(offset, offset + 1).map(threadFromRecord);
      const nextOffset = offset + page.length;
      process.stdout.write(
        `${JSON.stringify({
          id: request.id,
          result: {
            data: page,
            nextCursor: nextOffset < sessions.length ? String(nextOffset) : null,
            backwardsCursor: page.length > 0 ? String(offset) : null,
          },
        })}\n`,
      );
      continue;
    }
    if (request.method === "thread/unsubscribe") {
      if (process.argv.includes("thread_unload_delay_secs=0")) loadedPolicies.delete(request.params.threadId);
      process.stdout.write(`${JSON.stringify({ id: request.id, result: { status: "unsubscribed" } })}\n`);
      sendNotification("thread/status/changed", { threadId: request.params.threadId, status: { type: "notLoaded" } });
      continue;
    }
    if (request.method === "thread/resume") {
      if ((process.env.MUHA_FAKE_CODEX_SCENARIO === "resume-closing" && !resumeClosingObserved) ||
        process.env.MUHA_FAKE_CODEX_SCENARIO === "resume-closing-forever") {
        resumeClosingObserved = true;
        process.stdout.write(`${JSON.stringify({ id: request.id, error: {
          code: -32600,
          message: `thread ${request.params.threadId} is closing; retry thread/resume after the thread is closed`,
        } })}\n`);
        continue;
      }
      if (rejectUnexpectedSandbox(request)) continue;
      if (process.env.MUHA_FAKE_SESSION_REQUEST_FILE) {
        await writeFile(process.env.MUHA_FAKE_SESSION_REQUEST_FILE, JSON.stringify(request.params));
      }
      const sessions = await readNativeSessions();
      const record = sessions.find(({ id }) => id === request.params.threadId);
      if (!record) {
        process.stdout.write(
          `${JSON.stringify({ id: request.id, error: { code: "session_not_found", message: "not found" } })}\n`,
        );
        continue;
      }
      if (record.workspacePath !== request.params.cwd) {
        process.stdout.write(
          `${JSON.stringify({ id: request.id, error: { code: "workspace_mismatch", message: "mismatch" } })}\n`,
        );
        continue;
      }
      globalThis.__muhaLastWorkspacePath = record.workspacePath;
      const thread = threadFromRecord(record);
      const model = request.params.model ?? record.model ?? "fake-default";
      const applied = process.env.MUHA_FAKE_TURN_SCENARIO === "approval"
        ? loadedPolicies.get(record.id) ?? request.params : request.params;
      loadedPolicies.set(record.id, { approvalPolicy: applied.approvalPolicy, sandbox: applied.sandbox });
      process.stdout.write(
        `${JSON.stringify({
          id: request.id,
          result: {
            thread,
            model,
            modelProvider: "fake",
            serviceTier: null,
            cwd: record.workspacePath,
            instructionSources: [],
            approvalPolicy: applied.approvalPolicy,
            approvalsReviewer: "user",
            sandbox: { type: process.env.MUHA_FAKE_TURN_SCENARIO !== "wrong-permission-mode" && applied.sandbox === "danger-full-access" ? "dangerFullAccess" : "workspaceWrite" },
            reasoningEffort: null,
          },
        })}\n`,
      );
      process.stdout.write(`${JSON.stringify({ method: "thread/started", params: { thread } })}\n`);
      continue;
    }
    if (request.method === "thread/read") {
      const threadId = request.params.threadId;
      const sessions = await readNativeSessions();
      const record = sessions.find(({ id }) => id === threadId);
      if (!record) {
        process.stdout.write(
          `${JSON.stringify({ id: request.id, error: { code: "session_not_found", message: "not found" } })}\n`,
        );
        continue;
      }
      if (process.env.MUHA_FAKE_TURN_SCENARIO === "recover-thread-read-fails") {
        process.stdout.write(
          `${JSON.stringify({ id: request.id, error: { code: "internal_error", message: "fixture thread/read failure" } })}\n`,
        );
        continue;
      }
      const thread = threadFromRecord(record);
      if (request.params.includeTurns === true) {
        thread.turns = threadTurns.get(threadId) ?? [];
      }
      process.stdout.write(
        `${JSON.stringify({ id: request.id, result: { thread } })}\n`,
      );
      continue;
    }
    if (request.method === "model/list") {
      if (process.env.MUHA_FAKE_MODEL_LIST_DELAY_MS) {
        await new Promise((resolve) =>
          setTimeout(resolve, Number(process.env.MUHA_FAKE_MODEL_LIST_DELAY_MS)),
        );
      }
      const models = [
        { id: "fake-default", model: "fake-default", displayName: "fake-default", hidden: false, supportedReasoningEfforts: [{ reasoningEffort: "medium", description: "medium" }], defaultReasoningEffort: "medium" },
        { id: "fake-high", model: "fake-high", displayName: "fake-high", hidden: false, supportedReasoningEfforts: [{ reasoningEffort: "high", description: "high" }], defaultReasoningEffort: "high" },
        { id: "fake-minimal", model: "fake-minimal", displayName: "fake-minimal", hidden: false },
      ];
      const offset = request.params.cursor === undefined ? 0 : Number(request.params.cursor);
      const entries = models.slice(offset, offset + 1);
      process.stdout.write(
        `${JSON.stringify({
          id: request.id,
          result: {
            data: entries,
            nextCursor: offset + entries.length < models.length ? String(offset + entries.length) : null,
          },
        })}\n`,
      );
      continue;
    }
    if (request.method === "turn/start") {
      if ("reasoningEffort" in request.params) {
        process.stdout.write(
          `${JSON.stringify({
            id: request.id,
            error: { code: "invalid_params", message: "turn/start uses effort" },
          })}\n`,
        );
        continue;
      }
      turnRequestCount += 1;
      if (process.env.MUHA_FAKE_TURN_REQUEST_COUNT_FILE) {
        await writeFile(process.env.MUHA_FAKE_TURN_REQUEST_COUNT_FILE, String(turnRequestCount));
      }
      if (process.env.MUHA_FAKE_TURN_REJECT === "1") {
        process.stdout.write(
          `${JSON.stringify({
            id: request.id,
            error: { code: "fake_rejected", message: "fixture rejected Turn" },
          })}\n`,
        );
        continue;
      }
      if (
        process.env.MUHA_FAKE_REJECT_IMAGE === "1" &&
        request.params.input.some(({ type }) => type === "image" || type === "localImage")
      ) {
        process.stdout.write(
          `${JSON.stringify({
            id: request.id,
            error: { code: "image_not_supported", message: "fixture model rejected image" },
          })}\n`,
        );
        continue;
      }
      if (process.env.MUHA_FAKE_TURN_ACCEPT_DELAY_MS) {
        await new Promise((resolve) =>
          setTimeout(resolve, Number(process.env.MUHA_FAKE_TURN_ACCEPT_DELAY_MS)),
        );
      }
      if (process.env.MUHA_FAKE_TURN_ACCEPTED_FILE) {
        await writeFile(process.env.MUHA_FAKE_TURN_ACCEPTED_FILE, "accepted");
      }
      if (process.env.MUHA_FAKE_TURN_REQUEST_FILE) {
        await writeFile(process.env.MUHA_FAKE_TURN_REQUEST_FILE, JSON.stringify(request.params));
      }
      if (request.params.model) {
        const sessions = await readNativeSessions();
        const record = sessions.find(({ id }) => id === request.params.threadId);
        if (record) {
          record.model = request.params.model;
          await writeNativeSessions(sessions);
        }
      }
      const turn = {
        id: "turn_native_fake_1",
        items: [],
        itemsView: { type: "full" },
        status: "inProgress",
        error: null,
        startedAt: 1,
        completedAt: null,
        durationMs: null,
      };
      process.stdout.write(`${JSON.stringify({ id: request.id, result: { turn } })}\n`);
      if (process.env.MUHA_FAKE_TURN_DELAY_MS) {
        await new Promise((resolve) =>
          setTimeout(resolve, Number(process.env.MUHA_FAKE_TURN_DELAY_MS)),
        );
      }
      if (process.env.MUHA_FAKE_TURN_SCENARIO === "rich") {
        emitRichTurn(request.params.threadId, turn);
        continue;
      }
      if (process.env.MUHA_FAKE_TURN_SCENARIO === "background-usage-before-start") {
        sendNotification("thread/tokenUsage/updated", {
          threadId: request.params.threadId,
          turnId: "turn_native_previous",
          tokenUsage: usage(7, 3, 1, 1),
        });
      }
      if (process.env.MUHA_FAKE_TURN_SCENARIO === "burst-alternating") {
        emitAlternatingBurst(request.params.threadId, turn);
        continue;
      }
      if (
        process.env.MUHA_FAKE_TURN_SCENARIO === "burst-coalescible" ||
        process.env.MUHA_FAKE_TURN_SCENARIO === "burst-coalescible-utf8"
      ) {
        emitCoalescibleBurst(request.params.threadId, turn);
        continue;
      }
      if (process.env.MUHA_FAKE_TURN_SCENARIO === "oversize-delta") {
        emitOversizeDelta(request.params.threadId, turn);
        continue;
      }
      if (process.env.MUHA_FAKE_TURN_SCENARIO === "mcp-elicitations") {
        activeElicitation = beginElicitationTurn(request.params.threadId, turn);
        continue;
      }
      if (process.env.MUHA_FAKE_TURN_SCENARIO?.startsWith("approval")) {
        const approval = beginApprovalTurn(request.params.threadId, turn);
        if (process.env.MUHA_FAKE_TURN_SCENARIO === "approval-invalidated-by-harness") {
          sendNotification("serverRequest/resolved", {
            threadId: request.params.threadId,
            requestId: approval.requestId,
          });
          turn.status = "failed";
          turn.error = { message: "native fixture failure after invalidation" };
          sendNotification("turn/completed", { threadId: request.params.threadId, turn });
        } else if (process.env.MUHA_FAKE_TURN_SCENARIO === "approval-invalidated-by-turn") {
          turn.status = "failed";
          turn.error = { message: "native fixture failure with pending approval" };
          sendNotification("turn/completed", { threadId: request.params.threadId, turn });
        } else {
          activeApproval = approval;
        }
        continue;
      }
      if (process.env.MUHA_FAKE_TURN_SCENARIO?.startsWith("question")) {
        activeQuestion = beginQuestionTurn(request.params.threadId, turn);
        continue;
      }
      if (process.env.MUHA_FAKE_TURN_SCENARIO?.startsWith("held")) {
        activeTurn = turn;
        activeTurnThreadId = request.params.threadId;
        sendNotification("turn/started", {
          threadId: activeTurnThreadId,
          turn: activeTurn,
        });
        if (process.env.MUHA_FAKE_TURN_SCENARIO === "held-exit-process") {
          setTimeout(() => process.exit(23), 25);
        }
        continue;
      }
      if (process.env.MUHA_FAKE_TURN_SCENARIO?.startsWith("recover-")) {
        emitRecoveryScenario(process.env.MUHA_FAKE_TURN_SCENARIO, request.params.threadId, turn);
        continue;
      }
      if (
        process.env.MUHA_FAKE_TURN_SCENARIO?.startsWith("protocol-") ||
        process.env.MUHA_FAKE_TURN_SCENARIO?.startsWith("native-")
      ) {
        emitTerminalScenario(
          process.env.MUHA_FAKE_TURN_SCENARIO,
          request.params.threadId,
          turn,
        );
        continue;
      }
      process.stdout.write(
        `${JSON.stringify({ method: "turn/started", params: { threadId: request.params.threadId, turn } })}\n`,
      );
      const item = {
        type: "agentMessage",
        id: `message_native_fake_${turnRequestCount}`,
        text: "",
        phase: "final_answer",
        memoryCitation: null,
      };
      process.stdout.write(
        `${JSON.stringify({ method: "item/started", params: { item, threadId: request.params.threadId, turnId: turn.id, startedAtMs: 1 } })}\n`,
      );
      for (const delta of ["Hello", " from Codex."]) {
        process.stdout.write(
          `${JSON.stringify({ method: "item/agentMessage/delta", params: { threadId: request.params.threadId, turnId: turn.id, itemId: item.id, delta } })}\n`,
        );
      }
      item.text = "Hello from Codex.";
      process.stdout.write(
        `${JSON.stringify({ method: "item/completed", params: { item, threadId: request.params.threadId, turnId: turn.id, completedAtMs: 2 } })}\n`,
      );
      turn.status = "completed";
      turn.items = [item];
      turn.completedAt = 2;
      turn.durationMs = 1;
      process.stdout.write(
        `${JSON.stringify({ method: "turn/completed", params: { threadId: request.params.threadId, turn } })}\n`,
      );
      continue;
    }
    if (request.method === "turn/interrupt") {
      interruptCount += 1;
      if (process.env.MUHA_FAKE_INTERRUPT_COUNT_FILE) {
        await writeFile(process.env.MUHA_FAKE_INTERRUPT_COUNT_FILE, String(interruptCount));
      }
      if (process.env.MUHA_FAKE_TURN_SCENARIO === "held-interrupt-rejected") {
        process.stdout.write(
          `${JSON.stringify({ id: request.id, error: { code: "interrupt_rejected", message: "rejected" } })}\n`,
        );
        continue;
      }
      process.stdout.write(`${JSON.stringify({ id: request.id, result: {} })}\n`);
      if (activeTurn && request.params.turnId === activeTurn.id) {
        activeTurn.status = "interrupted";
        activeTurn.completedAt = 2;
        sendNotification("turn/completed", {
          threadId: activeTurnThreadId,
          turn: activeTurn,
        });
        activeTurn = undefined;
        activeTurnThreadId = undefined;
      }
      continue;
    }
    process.stderr.write(`unexpected fake Codex method: ${String(request.method)}\n`);
    process.exitCode = 67;
    break;
  }
  void keepAlive;
}

async function writePid(path, pid) {
  const temporaryPath = `${path}.${process.pid}.tmp`;
  await writeFile(temporaryPath, String(pid));
  await rename(temporaryPath, path);
}

function rejectUnexpectedSandbox(request) {
  if (["workspace-write", "danger-full-access"].includes(request.params?.sandbox)) return false;
  process.stdout.write(`${JSON.stringify({
    id: request.id,
    error: {
      code: "invalid_request",
      message: "expected workspace-write sandbox",
    },
  })}\n`);
  return true;
}

async function readNativeSessions() {
  if (!process.env.MUHA_FAKE_NATIVE_SESSIONS_FILE) return [];
  try {
    return JSON.parse(await readFile(process.env.MUHA_FAKE_NATIVE_SESSIONS_FILE, "utf8"));
  } catch (error) {
    if (error?.code === "ENOENT") return [];
    throw error;
  }
}

async function writeNativeSessions(sessions) {
  if (process.env.MUHA_FAKE_NATIVE_SESSIONS_FILE) {
    await writeFile(process.env.MUHA_FAKE_NATIVE_SESSIONS_FILE, JSON.stringify(sessions));
  }
}

function threadFromRecord(record) {
  return {
    id: record.id,
    sessionId: record.id,
    forkedFromId: null,
    parentThreadId: null,
    preview: "",
    ephemeral: false,
    isPinned: false,
    modelProvider: "fake",
    createdAt: record.createdAt ?? 1,
    updatedAt: record.updatedAt ?? record.createdAt ?? 1,
    recencyAt: null,
    status: { type: "idle" },
    path: null,
    cwd: record.workspacePath,
    cliVersion: "fake",
    source: "appServer",
    threadSource: null,
    agentNickname: null,
    agentRole: null,
    gitInfo: null,
    name: record.title ?? null,
    turns: [],
  };
}

async function emitRichTurn(threadId, turn) {
  sendNotification("turn/started", { threadId, turn });
  for (const pair of JSON.parse(process.env.MUHA_FAKE_EXTRA_NATIVE_ITEMS ?? "[]")) {
    sendNotification("item/started", { threadId, turnId: turn.id, item: pair.started });
    sendNotification("item/completed", { threadId, turnId: turn.id, item: pair.completed });
  }
  if (process.env.MUHA_FAKE_EXTRA_TOOL === "imageView") {
    const item = { id: "native_extra", type: "imageView", path: "/native/picture.png" };
    sendNotification("item/started", { threadId, turnId: turn.id, item });
    // Upstream ACP reports this item as completed at native item/started.
    // The actual native terminal arrives later, without another ACP update.
    if (process.env.MUHA_FAKE_STALL_IMAGE_VIEW === "1") return;
    await new Promise(resolve => setTimeout(resolve, 40));
    sendNotification("item/completed", { threadId, turnId: turn.id, item });
  }
  if (process.env.MUHA_FAKE_EXTRA_TOOL === "webSearch") {
    const item = { id: "native_extra", type: "webSearch", query: "muha", action: { type: "search", query: "muha", queries: ["muha"] }, results: null };
    sendNotification("item/started", { threadId, turnId: turn.id, item });
    sendNotification("item/completed", { threadId, turnId: turn.id, item: { ...item, results: [{ title: "Result", url: "https://example.test/muha" }] } });
  }
  const reasoning = { type: "reasoning", id: "reason_native_1", summary: [], content: [] };
  sendNotification("item/started", { item: reasoning, threadId, turnId: turn.id, startedAtMs: 1 });
